# ----------------------------------------------------------------
# General Python
# ----------------------------------------------------------------

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----------------------------------------------------------------
# Python Virtual Environments
# ----------------------------------------------------------------
# Never commit your environment folder
venv/
env/
.venv/
.env/
ENV/
.tox/

# ----------------------------------------------------------------
# Data Science & Jupyter
# ----------------------------------------------------------------

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VS Code Jupyter notebook history
.vscode/.ipynb
.history/

# Data files
# It's good practice to NOT commit large data files to Git.
# Uncomment these lines if your data is large.
# *.csv
# *.json
# *.jsonl
# *.parquet
# *.xlsx
# *.xls
# *.h5
# *.hdf5

# Model files
# Models can be very large; store them separately (e.g., S3, Git LFS)
# *.pkl
# *.pickle
# *.joblib
# *.model
# *.pth
# *.pt

# Generated output files (like plots)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf

# ----------------------------------------------------------------
# Secrets & Config
# ----------------------------------------------------------------
# Never commit your secrets, API keys, or local config
*.env
.env
.env.*
secrets.yml
config.ini
*.ini

# ----------------------------------------------------------------
# IDE / Editor Files
# ----------------------------------------------------------------

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-workspace

# PyCharm
.idea/
*.iml

# ----------------------------------------------------------------
# OS-specific files
# ----------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini